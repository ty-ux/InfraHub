# ============================================================
# InfraHub 测试环境 Compose —— 现场凭据模板（不含任何真实值）
# ============================================================
# 用法：复制到**仓库之外**并收紧权限，不要把填好的文件放进仓库：
#   mkdir -p ~/.config/infrahub
#   cp deploy/.env.infrahub-test.example ~/.config/infrahub/infrahub-test.env
#   chmod 600 ~/.config/infrahub/infrahub-test.env
# 然后按 docker-compose.infrahub-test.yml 顶部说明，用 --env-file 指定该文件。
#
# 下面每一项都必须在现场填写；Compose 对缺少的项会直接报错，不会使用默认口令。
# 本模板只描述"需要哪些值"，不提供任何可直接使用的凭据。

# ---------- 现有测试数据库（外部，不由本编排创建） ----------
# 示例格式：jdbc:postgresql://db.example.com:5432/infrahub
INFRAHUB_DB_URL=
INFRAHUB_DB_USERNAME=
# 数据库口令：由现场提供，不要写进仓库、文档或聊天记录
INFRAHUB_DB_PASSWORD=

# ---------- JWT ----------
# 至少 32 字节的随机值；与 SSH 单机实例使用**不同**的密钥，便于分别失效
INFRAHUB_JWT_SECRET=
INFRAHUB_JWT_ISSUER=infrahub
INFRAHUB_JWT_EXPIRE_SECONDS=7200

# ---------- 宿主机端口 ----------
# 后端默认 18080：避开 SSH 单机实例占用的 8080
INFRAHUB_BACKEND_HOST_PORT=18080
# 前端默认 18088
INFRAHUB_FRONTEND_HOST_PORT=18088

# Set for the first admin login on an uninitialized database.
INFRAHUB_AUTH_BOOTSTRAP_ADMIN_PASSWORD=
