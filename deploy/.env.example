# Copy this file to .env and fill in the credentials before starting Compose.
POSTGRES_DB=infrahub
POSTGRES_USER=infrahub
POSTGRES_PASSWORD=
# Use a random signing key of at least 32 bytes.
JWT_SECRET=
# Set at least 15 characters for the first admin login, then remove it after changing the password.
INFRAHUB_AUTH_BOOTSTRAP_ADMIN_PASSWORD=
JWT_ISSUER=infrahub
JWT_EXPIRE_SECONDS=7200
BACKEND_PORT=8080
FRONTEND_PORT=8088
